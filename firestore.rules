rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['age', 'gender', 'height', 'weight', 'targetWeight', 'activityLevel', 'bmi', 'bmiCategory', 'tdee', 'targets', 'createdAt', 'updatedAt']) &&
             data.age is number &&
             data.gender is string && data.gender.size() <= 10 &&
             data.height is number &&
             data.weight is number &&
             data.targetWeight is number &&
             data.activityLevel is string && data.activityLevel.size() <= 20 &&
             data.bmi is number &&
             data.bmiCategory is string && data.bmiCategory.size() <= 30 &&
             data.tdee is number &&
             data.targets is map &&
             data.targets.keys().hasAll(['calories', 'protein', 'carbs', 'fats', 'fiber']) &&
             data.targets.calories is number &&
             data.targets.protein is number &&
             data.targets.carbs is number &&
             data.targets.fats is number &&
             data.targets.fiber is number &&
             (data.keys().hasAll(['manualCalories']) == false || data.manualCalories is number) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasAny(['age', 'gender', 'height', 'weight', 'targetWeight', 'activityLevel', 'manualCalories', 'bmi', 'bmiCategory', 'tdee', 'targets', 'updatedAt']) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
        
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
